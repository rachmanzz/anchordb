[Unit]
Description=AnchorDB Computational Database Engine
Documentation=https://github.com/rachmanzz/anchordb
After=network.target

[Service]
Type=simple
User=anchordb
Group=anchordb
EnvironmentFile=-/etc/default/anchordb
EnvironmentFile=-/etc/sysconfig/anchordb
ExecStart=/usr/bin/anchordb-server -port=${PORT} -data-dir=${DATA_DIR} -auth-token=${AUTH_TOKEN} -wal-sync=${WAL_SYNC} -wal-sync-interval=${WAL_SYNC_INTERVAL} -rate-limit=${RATE_LIMIT}
Restart=always
RestartSec=3s
LimitNOFILE=65536
LimitNPROC=65536

# Sandboxing & security protections
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/anchordb

[Install]
WantedBy=multi-user.target
