[Unit]
Description=AnchorDB High-Performance Computational Database Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/anchordb
ExecStart=/opt/anchordb/anchordb-server
Restart=always
RestartSec=5

# Environment configuration
Environment=ANCHORDB_PORT=7447
Environment=ANCHORDB_DATA_DIR=/var/lib/anchordb
Environment=ANCHORDB_AUTH_TOKEN=

# Resource management
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
