[Unit]
Description=AnchorDB High-Performance Computational Database Daemon
After=network.target

[Service]
Type=simple
User=anchordb
Group=anchordb
WorkingDirectory=/var/lib/anchordb
ExecStart=/opt/anchordb/anchordb-server
Restart=always
RestartSec=5

# Core Server Configuration
Environment=ANCHORDB_PORT=7447
Environment=ANCHORDB_WIRE_PORT=7448
Environment=ANCHORDB_DATA_DIR=/var/lib/anchordb
# Authentication is enforced by default. Set a secure secret token (e.g. `openssl rand -hex 32`).
# For local-only development without a token, ANCHORDB_ALLOW_INSECURE can be set to true.
Environment=ANCHORDB_AUTH_TOKEN=change-me-to-a-secure-random-token
Environment=ANCHORDB_ALLOW_INSECURE=false
Environment=ANCHORDB_MEMORY_LIMIT=800MB
Environment=ANCHORDB_IP_WHITELIST=127.0.0.1,::1
Environment=ANCHORDB_TRUST_PROXY=false

# Background Subsystems (Cron, Worker, Queue)
Environment=ANCHORDB_CRON_ENABLED=true
Environment=ANCHORDB_PARTITION_SCHEDULE=23:00
Environment=ANCHORDB_PARTITION_RETENTION_DAYS=180
Environment=ANCHORDB_SYNC_INTERVAL=5m
Environment=ANCHORDB_WORKER_ENABLED=true
Environment=ANCHORDB_WORKER_CONCURRENCY=8
Environment=ANCHORDB_WORKER_QUEUE_SIZE=1000
Environment=ANCHORDB_QUEUE_ENABLED=true
Environment=ANCHORDB_QUEUE_CONSUMER_ENABLED=true
Environment=ANCHORDB_QUEUE_MAX_SIZE=10000

# Security & Resource limits
LimitNOFILE=65535
MemoryMax=1G
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
